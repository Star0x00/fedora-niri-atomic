{
  # Install order matters for layer caching: put the most stable,
  # foundational packages first so they land in early (cached) layers,
  # and the frequently-changing ones (desktop, gaming) last.
  #
  # NOTE: keep this list in sync with the RUN layers in the Containerfile.
  install_order: ["system" "fonts" "services" "utils" "desktop" "gaming"]

  reinstall: []

  groups: {
    # ---------------------------------------------------------------
    # system  — foundational, very rarely churn (cached best)
    # ---------------------------------------------------------------
    system: [
      "zram-generator"
      "mesa-vulkan-drivers"
    ]

    # ---------------------------------------------------------------
    # fonts
    # ---------------------------------------------------------------
    fonts: [
      "google-noto-sans-fonts"
      "google-noto-sans-yi-fonts"
      "google-noto-serif-tibetan-fonts"
      "google-noto-emoji-fonts"
      "google-noto-color-emoji-fonts"
      "iosevka-custom-fonts"
    ]

    # ---------------------------------------------------------------
    # services  — daemons / virtualization / audio / network
    # ---------------------------------------------------------------
    services: [
      # virtualization
      "qemu-kvm"
      "libvirt-daemon-kvm"
      "libvirt-daemon-config-network"
      "libvirt-client"
      "virt-install"
      "virt-manager"
      "virt-viewer"
      "edk2-ovmf"
      "swtpm"
      # audio
      "pipewire"
      "pipewire-utils"
      "wireplumber"
      "pipewire-alsa"
      "pipewire-pulseaudio"
      "mpd"
      # network
      "NetworkManager-wifi"
      "iwlwifi-mvm-firmware"
      # system daemons
      "upower"
    ]

    # ---------------------------------------------------------------
    # utils  — CLI / dev / container tooling
    # ---------------------------------------------------------------
    utils: [
      # package & container management
      "distrobox"
      "systemd-container"
      # graphics / system
      "vulkan-tools"
      "xdg-utils"
      "glibc-langpack-en"
      "mise"
      "pass"
      "zmx"
      "go-musicfox"
      "playerctl"
      "gtk-murrine-engine"
      "zsh"
      "flow"
    ]

    # ---------------------------------------------------------------
    # desktop  — GUI session, changes most often (cached worst)
    # ---------------------------------------------------------------
    desktop: [
      # window managers
      "niri"
      #theme
      "bibata-cursor-theme"
      "colloid-gtk-theme"
      "adw-gtk3-theme"
      "gnome-tweaks"
      # file managers
      "nautilus"
      # desktop portals
      "xdg-desktop-portal"
      "xdg-desktop-portal-gnome"
      "xdg-desktop-portal-gtk"
      # terminal emulators
      "monstar"
      "ghostty"
      # screenshot
      "grim"
      "slurp"
      "satty"
      # clipboard
      "cliphist"
      "noctalia-git"
      # input method (Chinese)
      "fcitx5"
      "fcitx5-configtool"
      "fcitx5-chinese-addons"
      "fcitx5-rime"
      # flatpak
      "flatpak"
      "vicinae"
      "gram"
    ]

    gaming: []
  }

  remove: [
    "firefox"
    "firefox-langpacks"
    # X11 apps video bridge; nothing requires it, unused on a niri/plasma-wayland desktop
    "xwaylandvideobridge"
    # base image (fedora-bootc:44) ships nfs-utils and preset-enables
    # nfs-client.target; drop the whole NFS/RPC family since nothing
    # else depends on it (no NFS shares are mounted here).
    "nfs-utils"
    "nfs-client-utils"
    "nfs-common-utils"
    "nfsv3-client-utils"
    "nfsv4-client-utils"
    "rpcbind"
    "gssproxy"
    "quota"
    "quota-nls"
  ]
}

{
  rpmfusion_release_templates: [
    "https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-{fedora}.noarch.rpm"
    "https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-{fedora}.noarch.rpm"
  ]

  config_manager_setopts: [
    "fedora-cisco-openh264.enabled=1"
    # GramEditor RPM package signing is not functional yet; must disable
    # signature check for this repo only.
    "gitea-grameditor.gpgcheck=0"
  ]

  disable_glob: "*rawhide*"

  # external repo files added via `dnf config-manager addrepo --from-repofile=<url>`
  external_repos: [
    "https://codeberg.org/api/packages/GramEditor/rpm.repo"
  ]

  copr: {
    enable_order: ["kernel" "desktop" "utils"]

    groups: {
      kernel: []

      desktop: [
        "qwerhyy/misc-packages"
        "lionheartp/Hyprland"
        "yalter/niri"
        "quadratech188/vicinae"
      ]

      utils: [
        "peterwu/rendezvous"
        "jdxcode/mise"
      ]
    }
  }

  priority_overrides: [
    {
      file: "_copr:copr.fedorainfracloud.org:yalter:niri.repo"
      value: 1
    }
    {
      file: "_copr:copr.fedorainfracloud.org:qwerhyy:misc-packages.repo"
      value: 1
    }
    {
      file: "_copr:copr.fedorainfracloud.org:lionheartp:Hyprland.repo"
      value: 1
    }
  ]
}
